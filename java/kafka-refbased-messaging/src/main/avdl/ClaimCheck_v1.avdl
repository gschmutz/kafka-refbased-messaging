@namespace("com.trivadis.demo.dto")
protocol ClaimCheckProtocol {

  /**
   * Reference (Claim Check) message for Reference-Based Messaging.
   *
   * Instead of sending a large Avro payload through Kafka, the payload is
   * externalized to object storage (e.g. S3/MinIO) and only this lightweight
   * reference is published on the topic. Consumers use the reference to fetch
   * and deserialize the original payload from storage.
   */
  record ClaimCheck {
    /** Time the reference was created (event timestamp), in epoch milliseconds. */
    timestamp_ms ts;

    /**
     * Type / record name of the externalized Avro payload (e.g. "Person",
     * "Product"). May be a simple name or a fully qualified class name; the
     * consumer uses it to resolve the target type for deserialization.
     */
    string payloadType;

    /**
     * URI referencing the externalized payload in object storage, encoding both the
     * storage bucket and the object key (e.g. "s3://my-bucket/path/to/object").
     */
    string payloadReference;
  }
}
